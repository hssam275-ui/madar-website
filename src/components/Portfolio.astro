---
// Filterable portfolio grid with a lightbox player.
// Video cards show a muted preview on hover (or when scrolled into view on touch screens).
import Icon from './Icon.astro';
import { projects, categories, media } from '../data/projects';
import type { HomeCopy } from '../i18n/home';

interface Props {
  lang: 'ar' | 'en';
  t: HomeCopy['work'];
}
const { lang, t } = Astro.props;
const catName = (id: string) => categories.find((c) => c.id === id)![lang];
const used = categories.filter((c) => projects.some((p) => p.category === c.id));
---

<section class="section work-section" id="work">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">{t.eyebrow}</p>
      <h2>{t.title}</h2>
      <p>{t.lead}</p>
    </div>

    <div class="filters" role="group" aria-label={t.filterLabel}>
      <button type="button" class="chip" aria-pressed="true" data-filter="all">{t.all}</button>
      {used.map((c) => <button type="button" class="chip" aria-pressed="false" data-filter={c.id}>{c[lang]}</button>)}
    </div>

    <ul class="grid">
      {
        projects.map((p) => {
          const m = media(p);
          return (
            <li class={`item ${p.orientation} ${p.featured ? 'featured' : ''}`} data-category={p.category}>
              <button
                type="button"
                class="card"
                data-kind={p.kind}
                data-src={m.src}
                data-poster={m.poster}
                data-title={p[lang].title}
                aria-label={`${p.kind === 'video' ? t.watch : t.view}: ${p[lang].title}`}
              >
                <span class="media">
                  <img src={m.poster} alt="" loading="lazy" decoding="async" />
                  {p.kind === 'video' && <video data-preview={m.preview} muted loop playsinline preload="none" aria-hidden="true" />}
                  {p.kind === 'video' && (
                    <span class="play" aria-hidden="true">
                      <Icon name="play" size={18} />
                    </span>
                  )}
                </span>
                <span class="meta">
                  <span class="cat">{catName(p.category)}</span>
                  <span class="title">{p[lang].title}</span>
                  {p[lang].client && <span class="client">{p[lang].client}</span>}
                  <span class="summary">{p[lang].summary}</span>
                </span>
              </button>
            </li>
          );
        })
      }
    </ul>
  </div>

  <dialog class="lightbox" aria-label={t.title}>
    <button type="button" class="close" aria-label={t.close}><Icon name="close" /></button>
    <div class="stage"></div>
    <p class="caption"></p>
  </dialog>
</section>

<script>
  const root = document.querySelector<HTMLElement>('#work')!;
  const items = [...root.querySelectorAll<HTMLElement>('.item')];
  const chips = [...root.querySelectorAll<HTMLButtonElement>('.chip')];

  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      const f = chip.dataset.filter;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      items.forEach((it) => (it.hidden = f !== 'all' && it.dataset.category !== f));
    }),
  );

  // Hover / in-view previews
  const start = (v: HTMLVideoElement) => {
    if (!v.src) v.src = v.dataset.preview!;
    v.play().then(() => v.classList.add('on')).catch(() => {});
  };
  const stop = (v: HTMLVideoElement) => {
    v.pause();
    v.classList.remove('on');
  };
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hover = matchMedia('(hover: hover)').matches;
  const previews = [...root.querySelectorAll<HTMLVideoElement>('video[data-preview]')];
  if (!reduce) {
    if (hover) {
      previews.forEach((v) => {
        const card = v.closest('.card')!;
        card.addEventListener('mouseenter', () => start(v));
        card.addEventListener('mouseleave', () => stop(v));
      });
    } else {
      const io = new IntersectionObserver(
        (es) => es.forEach((e) => (e.isIntersecting ? start : stop)(e.target as HTMLVideoElement)),
        { threshold: 0.6 },
      );
      previews.forEach((v) => io.observe(v));
    }
  }

  // Lightbox
  const dialog = root.querySelector<HTMLDialogElement>('.lightbox')!;
  const stage = dialog.querySelector<HTMLElement>('.stage')!;
  const caption = dialog.querySelector<HTMLElement>('.caption')!;
  const close = () => dialog.close();
  dialog.addEventListener('close', () => (stage.innerHTML = ''));
  dialog.querySelector('.close')!.addEventListener('click', close);
  dialog.addEventListener('click', (e) => e.target === dialog && close());

  root.querySelectorAll<HTMLButtonElement>('.card').forEach((card) =>
    card.addEventListener('click', () => {
      const d = card.dataset;
      const el =
        d.kind === 'video'
          ? Object.assign(document.createElement('video'), { src: d.src!, poster: d.poster!, controls: true, autoplay: true, playsInline: true })
          : Object.assign(document.createElement('img'), { src: d.src!, alt: d.title! });
      stage.replaceChildren(el);
      caption.textContent = d.title!;
      dialog.showModal();
    }),
  );
</script>

<style>
  .work-section {
    background: var(--bg-raised);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-block-end: 32px;
  }
  .chip {
    min-height: 42px;
    padding: 8px 18px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--text-muted);
    font: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }
  .chip:hover {
    color: var(--text);
    border-color: rgba(180, 230, 245, 0.3);
  }
  .chip[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  /* 4-column dense grid: landscape spans 2 cols, portrait spans 2 rows. */
  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: minmax(0, auto);
    grid-auto-flow: dense;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .item {
    min-width: 0;
  }
  .item.landscape {
    grid-column: span 2;
  }
  .item.portrait {
    grid-row: span 2;
  }
  .item.featured.landscape:first-child {
    grid-column: span 4;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: start;
    cursor: pointer;
  }
  .media {
    position: relative;
    display: block;
    width: 100%;
    flex: 1;
    min-height: 0;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-soft);
  }
  .portrait .media {
    aspect-ratio: 9 / 16;
  }
  .featured.landscape:first-child .media {
    aspect-ratio: 21 / 9;
  }
  .media img,
  .media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease, opacity 0.4s ease;
  }
  .media video {
    opacity: 0;
  }
  .media video.on {
    opacity: 1;
  }
  .card:hover .media img,
  .card:hover .media video {
    transform: scale(1.04);
  }
  .play {
    position: absolute;
    bottom: 14px;
    inset-inline-end: 14px;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgba(7, 18, 22, 0.65);
    backdrop-filter: blur(6px);
    color: var(--text);
    transition: background-color 0.2s, color 0.2s;
  }
  .card:hover .play {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .meta {
    display: grid;
    gap: 2px;
  }
  .cat {
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 600;
  }
  .title {
    font-size: 1.12rem;
    font-weight: 700;
  }
  .client {
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .summary {
    margin-block-start: 4px;
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .lightbox {
    width: min(1100px, calc(100vw - 32px));
    max-height: calc(100vh - 32px);
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text);
    overflow: hidden;
  }
  .lightbox::backdrop {
    background: rgba(3, 10, 12, 0.88);
    backdrop-filter: blur(6px);
  }
  .stage :global(video),
  .stage :global(img) {
    display: block;
    width: 100%;
    max-height: calc(100vh - 120px);
    object-fit: contain;
    background: #000;
  }
  .caption {
    padding: 14px 20px;
    font-weight: 600;
  }
  .close {
    position: absolute;
    top: 12px;
    inset-inline-end: 12px;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 0;
    background: rgba(7, 18, 22, 0.7);
    color: var(--text);
    cursor: pointer;
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .item.featured.landscape:first-child {
      grid-column: span 2;
    }
    .featured.landscape:first-child .media {
      aspect-ratio: 16 / 9;
    }
  }
  @media (max-width: 560px) {
    .item.portrait {
      grid-row: auto;
    }
    .summary {
      display: none;
    }
  }
</style>
