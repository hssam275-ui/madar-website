---
// Dedicated page for one service group (media or print), in either language.
import { url } from '../utils/url';
import PageShell from './PageShell.astro';
import ServiceGrid from './ServiceGrid.astro';
import QuoteForm from './QuoteForm.astro';
import Icon from './Icon.astro';
import { home } from '../i18n/home';
import { servicePages } from '../i18n/servicePages';
import { servicesIn, type ServiceGroup } from '../data/services';
import { projects, media } from '../data/projects';
import { site } from '../data/site';

interface Props {
  lang: 'ar' | 'en';
  group: ServiceGroup;
}
const { lang, group } = Astro.props;
const t = home[lang];
const p = servicePages[group][lang];
const items = servicesIn(group);
const prefix = lang === 'ar' ? '' : '/en';
const altPath = url(`${lang === 'ar' ? '/en' : ''}/services/${group}/`);
const featured = group === 'media' ? projects.filter((x) => x.kind === 'video').slice(0, 3) : [];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: p.eyebrow,
    itemListElement: items.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Service',
        name: s[lang].title,
        description: s[lang].summary,
        areaServed: 'SA',
        provider: { '@type': 'Organization', name: site.name[lang] },
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: site.name[lang], item: new URL(url(`${prefix}/`), Astro.site).href },
      { '@type': 'ListItem', position: 2, name: p.eyebrow },
    ],
  },
];
---

<PageShell lang={lang} title={p.metaTitle} description={p.metaDescription} altPath={altPath} schema={schema}>
  <section class="page-hero">
    <div class="container">
      <nav class="crumbs" aria-label={lang === 'ar' ? 'مسار التنقل' : 'Breadcrumb'}>
        <a href={url(`${prefix}/`)}>{site.shortName[lang]}</a>
        <span aria-hidden="true">/</span>
        <span>{p.eyebrow}</span>
      </nav>
      <p class="eyebrow">{p.eyebrow}</p>
      <h1>{p.title}</h1>
      <p class="lead">{p.lead}</p>
      <div class="ctas">
        <a class="btn btn-primary" href="#contact">{t.nav.quote} <Icon name="arrow" size={18} /></a>
        <a class="btn btn-ghost" href={url(`${prefix}/services/${group === 'media' ? 'print' : 'media'}/`)}>
          {group === 'media' ? t.nav.printServices : t.nav.mediaServices}
        </a>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <ServiceGrid lang={lang} items={items} cta={t.services.cta} href="#contact" cols={group === 'print' ? 3 : 4} />
    </div>
  </section>

  {
    group === 'media' && (
      <section class="section">
        <div class="container">
          <div class="row-head">
            <h2>{(p as typeof servicePages.media.ar).workTitle}</h2>
            <a class="more" href={url(`${prefix}/#work`)}>
              {(p as typeof servicePages.media.ar).workCta} <Icon name="arrow" size={16} />
            </a>
          </div>
          <ul class="work">
            {featured.map((w) => (
              <li>
                <a href={url(`${prefix}/#work`)}>
                  <img src={media(w).poster} alt="" loading="lazy" decoding="async" />
                  <span>{w[lang].title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    group === 'print' && (
      <section class="section">
        <div class="container">
          <h2 class="steps-title">{(p as typeof servicePages.print.ar).stepsTitle}</h2>
          <ol class="steps">
            {(p as typeof servicePages.print.ar).steps.map((s, i) => (
              <li>
                <span class="num">{String(i + 1).padStart(2, '0')}</span>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  <section class="section contact-section" id="contact">
    <div class="container contact">
      <div class="contact-copy">
        <p class="eyebrow">{t.contact.eyebrow}</p>
        <h2>{t.contact.title}</h2>
        <p>{t.contact.lead}</p>
      </div>
      <QuoteForm lang={lang} t={t.contact.form} />
    </div>
  </section>
</PageShell>

<style>
  .page-hero {
    padding-block: clamp(130px, 16vw, 180px) clamp(40px, 6vw, 64px);
    background: radial-gradient(ellipse at 85% 0%, rgba(31, 176, 216, 0.16), transparent 55%);
  }
  .page-hero .container {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  .crumbs {
    display: flex;
    gap: 8px;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .crumbs a:hover {
    color: var(--accent);
  }
  h1 {
    max-width: 860px;
    font-size: clamp(2.2rem, 5.4vw, 4rem);
    line-height: 1.15;
  }
  .lead {
    max-width: 680px;
    color: var(--text-muted);
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .section-tight {
    padding-block: 24px clamp(48px, 8vw, 96px);
  }
  .row-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
    margin-block-end: 28px;
  }
  .row-head h2,
  .steps-title {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
  }
  .steps-title {
    margin-block-end: 36px;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent);
    font-weight: 600;
  }
  [dir='rtl'] .more :global(svg) {
    transform: scaleX(-1);
  }
  .work {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .work a {
    display: grid;
    gap: 12px;
    font-weight: 600;
  }
  .work img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    transition: transform 0.5s;
  }
  .work a:hover img {
    transform: scale(0.98);
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .steps li {
    display: grid;
    align-content: start;
    gap: 10px;
    padding-block-start: 24px;
    border-top: 1px solid var(--line);
  }
  .num {
    color: var(--accent);
    font-weight: 700;
  }
  .steps h3 {
    font-size: 1.2rem;
  }
  .steps p {
    color: var(--text-muted);
    font-size: 0.97rem;
  }
  .contact-section {
    background: var(--bg-raised);
  }
  .contact {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }
  .contact-copy {
    display: grid;
    gap: 18px;
  }
  .contact-copy h2 {
    font-size: clamp(1.9rem, 3.6vw, 2.9rem);
  }
  .contact-copy p {
    color: var(--text-muted);
  }
  @media (max-width: 960px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .contact {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .work,
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
