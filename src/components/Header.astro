---
import { url } from '../utils/url';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import type { HomeCopy } from '../i18n/home';

interface Props {
  lang: 'ar' | 'en';
  t: HomeCopy['nav'];
  altPath: string;
}
const { lang, t, altPath } = Astro.props;
const prefix = lang === 'ar' ? '' : '/en';
const home = url(`${prefix}/`);
const servicePages = [
  { href: url(`${prefix}/services/media/`), label: t.mediaServices, hint: t.mediaServicesHint, icon: 'film' },
  { href: url(`${prefix}/services/print/`), label: t.printServices, hint: t.printServicesHint, icon: 'printer' },
];
const links = [
  { href: `${home}#work`, label: t.work },
  { href: url('/blog/'), label: t.blog },
  { href: `${home}#faq`, label: t.faq },
  { href: `${home}#contact`, label: t.contact },
];
---

<header class="header" data-header>
  <div class="container bar">
    <a href={home} class="home-link"><Logo lang={lang} /></a>

    <nav class="nav" aria-label={lang === 'ar' ? 'القائمة الرئيسية' : 'Main navigation'}>
      <ul id="nav-list">
        <li class="has-menu">
          <button type="button" class="menu-btn" aria-expanded="false" aria-controls="services-menu">
            {t.services}
            <Icon name="chevron" size={16} />
          </button>
          <ul class="submenu" id="services-menu">
            {
              servicePages.map((p) => (
                <li>
                  <a href={p.href}>
                    <span class="sub-icon"><Icon name={p.icon} size={20} /></span>
                    <span>
                      <strong>{p.label}</strong>
                      <small>{p.hint}</small>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </li>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li class="lang-mobile"><a href={altPath} hreflang={lang === 'ar' ? 'en' : 'ar'}>{t.lang}</a></li>
      </ul>
    </nav>

    <div class="actions">
      <a class="lang" href={altPath} hreflang={lang === 'ar' ? 'en' : 'ar'}>{t.lang}</a>
      <a class="btn btn-primary quote" href={`${home}#contact`}>{t.quote}</a>
      <button class="toggle" type="button" aria-controls="nav-list" aria-expanded="false" data-open={t.menu} data-close={t.close}>
        <span class="visually-hidden">{t.menu}</span>
        <Icon name="menu" />
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const toggle = header.querySelector<HTMLButtonElement>('.toggle')!;
  const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    header.classList.toggle('open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector('.visually-hidden')!.textContent = open ? toggle.dataset.close! : toggle.dataset.open!;
  };
  toggle.addEventListener('click', () => setOpen(!header.classList.contains('open')));
  header.querySelectorAll('.nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

  // Services dropdown: click/tap toggles; hover opens on desktop via CSS; Escape and outside click close.
  const item = header.querySelector<HTMLElement>('.has-menu')!;
  const btn = item.querySelector<HTMLButtonElement>('.menu-btn')!;
  const setMenu = (open: boolean) => {
    item.classList.toggle('menu-open', open);
    btn.setAttribute('aria-expanded', String(open));
  };
  btn.addEventListener('click', () => setMenu(!item.classList.contains('menu-open')));
  document.addEventListener('click', (e) => !item.contains(e.target as Node) && setMenu(false));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setMenu(false));
</script>

<style>
  .header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 50;
    transition: background-color 0.3s ease, border-color 0.3s ease;
    border-bottom: 1px solid transparent;
  }
  .header.scrolled,
  .header.open {
    background: rgba(7, 18, 22, 0.85);
    backdrop-filter: blur(14px);
    border-bottom-color: var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 76px;
  }
  .nav > ul {
    display: flex;
    align-items: center;
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav a,
  .menu-btn {
    color: var(--text-muted);
    font-weight: 500;
    transition: color 0.2s;
  }
  .nav a:hover,
  .menu-btn:hover {
    color: var(--text);
  }
  .menu-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }
  .menu-btn :global(svg) {
    transition: transform 0.2s;
  }
  .has-menu {
    position: relative;
  }
  .submenu {
    position: absolute;
    top: calc(100% + 14px);
    inset-inline-start: -16px;
    display: grid;
    gap: 4px;
    width: 300px;
    margin: 0;
    padding: 8px;
    list-style: none;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raised);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.2s, transform 0.2s, visibility 0.2s;
  }
  /* bridge the gap so hover doesn't drop between button and menu */
  .submenu::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: -16px;
    height: 16px;
  }
  .has-menu.menu-open .submenu {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .has-menu.menu-open .menu-btn :global(svg) {
    transform: rotate(180deg);
  }
  @media (hover: hover) and (min-width: 961px) {
    .has-menu:hover .submenu {
      opacity: 1;
      visibility: visible;
      transform: none;
    }
  }
  .submenu a {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px;
    border-radius: var(--radius-sm);
    color: var(--text);
  }
  .submenu a:hover {
    background: var(--bg-soft);
  }
  .submenu strong {
    display: block;
    font-weight: 600;
  }
  .submenu small {
    display: block;
    color: var(--text-muted);
    font-size: 0.85rem;
  }
  .sub-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .lang {
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .lang:hover {
    color: var(--text);
  }
  .quote {
    min-height: 44px;
    padding: 8px 20px;
    font-size: 0.95rem;
  }
  .toggle,
  .lang-mobile {
    display: none;
  }

  @media (max-width: 960px) {
    .toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 1px solid var(--line);
      background: transparent;
      color: var(--text);
      cursor: pointer;
    }
    .lang {
      display: none;
    }
    .lang-mobile {
      display: block;
    }
    .nav {
      position: absolute;
      top: 76px;
      inset-inline: 0;
      display: none;
      max-height: calc(100vh - 76px);
      overflow-y: auto;
      background: rgba(7, 18, 22, 0.97);
      border-bottom: 1px solid var(--line);
    }
    .header.open .nav {
      display: block;
    }
    .nav > ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px var(--gutter) 24px;
    }
    .nav > ul > li > a,
    .menu-btn {
      display: flex;
      width: 100%;
      justify-content: space-between;
      padding: 14px 0;
      font-size: 1.1rem;
      color: var(--text);
      border-bottom: 1px solid var(--line);
    }
    .submenu {
      position: static;
      display: none;
      width: auto;
      padding: 8px 0;
      border: 0;
      background: none;
      box-shadow: none;
      opacity: 1;
      visibility: visible;
      transform: none;
    }
    .has-menu.menu-open .submenu {
      display: grid;
    }
  }
  @media (max-width: 480px) {
    .quote {
      padding: 8px 14px;
      font-size: 0.85rem;
    }
  }
</style>
