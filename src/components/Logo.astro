---
// TEMPORARY wordmark. Replace with Madar's official logo files once received.
import { site } from '../data/site';
interface Props {
  lang: 'ar' | 'en';
}
const { lang } = Astro.props;
---

<span class="logo">
  <svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true">
    <ellipse cx="16" cy="16" rx="14" ry="6.5" fill="none" stroke="currentColor" stroke-width="1.4" transform="rotate(-24 16 16)" opacity="0.55"></ellipse>
    <circle cx="16" cy="16" r="5" fill="var(--accent)"></circle>
  </svg>
  <span class="logo-text">{site.shortName[lang]}</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 1.35rem;
    letter-spacing: 0.01em;
  }
</style>
