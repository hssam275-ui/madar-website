---
import { url } from '../utils/url';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import QuoteForm from './QuoteForm.astro';
import Icon from './Icon.astro';
import { home } from '../i18n/home';
import { servicesIn } from '../data/services';
import ServiceGrid from './ServiceGrid.astro';
import BlogCard from './BlogCard.astro';
import { getCollection } from 'astro:content';
import Portfolio from './Portfolio.astro';
import { site, whatsappLink } from '../data/site';

interface Props {
  lang: 'ar' | 'en';
}
const { lang } = Astro.props;
const t = home[lang];
const altPath = url(lang === 'ar' ? '/en/' : '/');
const prefix = lang === 'ar' ? '' : '/en';
const posts = (await getCollection('blog', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const wa = whatsappLink(t.contact.whatsappMsg);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faq.items.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base title={t.meta.title} description={t.meta.description} lang={lang} altPath={altPath} schema={[faqSchema]}>
  <Header lang={lang} t={t.nav} altPath={altPath} />

  <main id="main">
    <!-- HERO -->
    <section class="hero">
      <div class="hero-orbit" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
      <div class="container hero-inner">
        <p class="eyebrow">{t.hero.eyebrow}</p>
        <h1>
          <span>{t.hero.title[0]}</span>
          <span class="accent">{t.hero.title[1]}</span>
        </h1>
        <p class="hero-lead">{t.hero.lead}</p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href="#contact">{t.hero.primary} <Icon name="arrow" size={18} /></a>
          <a class="btn btn-ghost" href="#work">{t.hero.secondary}</a>
        </div>
      </div>
      <div class="container">
        <!-- Montage loop cut from portfolio clips. Replace with the official showreel when ready. -->
        <a class="reel" href="#work" aria-label={t.hero.reel}>
          <video src={url('/work/showreel-loop.mp4')} poster={url('/work/showreel-loop.jpg')} autoplay muted loop playsinline preload="metadata" aria-hidden="true"></video>
          <span class="reel-label"><span class="reel-play"><Icon name="play" size={18} /></span>{t.hero.reel}</span>
        </a>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="section" id="services">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow">{t.services.eyebrow}</p>
          <h2>{t.services.title}</h2>
          <p>{t.services.lead}</p>
        </div>
        <ServiceGrid lang={lang} items={servicesIn('media')} cta={t.services.cta} href="#contact" />
        <a class="more-link" href={url(`${prefix}/services/media/`)}>{t.nav.mediaServices} <Icon name="arrow" size={16} /></a>
      </div>
    </section>

    <!-- WORK -->
    <Portfolio lang={lang} t={t.work} />

    <!-- PROCESS -->
    <section class="section" id="process">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow">{t.process.eyebrow}</p>
          <h2>{t.process.title}</h2>
        </div>
        <ol class="steps">
          {
            t.process.steps.map((s, i) => (
              <li class="step" data-reveal style={`transition-delay:${i * 80}ms`}>
                <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- STUDIO / PODCAST -->
    <section class="section studio-section">
      <div class="container studio" data-reveal>
        <div class="studio-copy">
          <p class="eyebrow">{t.studio.eyebrow}</p>
          <h2>{t.studio.title}</h2>
          <p>{t.studio.text}</p>
          <ul class="studio-points">
            {t.studio.points.map((pt) => <li><Icon name="check" size={18} /> {pt}</li>)}
          </ul>
          <a class="btn btn-primary" href="#contact" data-service="podcast">{t.studio.cta}</a>
        </div>
        <div class="studio-visual">
          <img src={url('/work/content-studio-setup.webp')} alt={t.studio.imageAlt} width="1600" height="900" loading="lazy" decoding="async" />
        </div>
      </div>
    </section>

    <!-- PRINT -->
    <section class="section print-section">
      <div class="container print" data-reveal>
        <div class="print-copy">
          <p class="eyebrow">{t.print.eyebrow}</p>
          <h2>{t.print.title}</h2>
          <p>{t.print.lead}</p>
          <a class="btn btn-primary" href={url(`${prefix}/services/print/`)}>{t.print.cta} <Icon name="arrow" size={18} /></a>
        </div>
        <ul class="print-list">
          {
            servicesIn('print').map((s) => (
              <li>
                <Icon name={s.icon} size={22} />
                {s[lang].title}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- WHY -->
    <section class="section">
      <div class="container why">
        <div class="section-head" data-reveal>
          <p class="eyebrow">{t.why.eyebrow}</p>
          <h2>{t.why.title}</h2>
        </div>
        <ul class="why-list">
          {
            t.why.items.map((w) => (
              <li data-reveal>
                <h3>{w.title}</h3>
                <p>{w.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- BLOG -->
    <section class="section blog-section">
      <div class="container">
        <div class="blog-head" data-reveal>
          <div class="section-head">
            <p class="eyebrow">{t.blogTeaser.eyebrow}</p>
            <h2>{t.blogTeaser.title}</h2>
          </div>
          <a class="more-link" href={url('/blog/')}>{t.blogTeaser.all} <Icon name="arrow" size={16} /></a>
        </div>
        <div class="blog-grid">
          {posts.map((post) => <BlogCard post={post} readLabel={t.blogTeaser.read} />)}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section" id="faq">
      <div class="container faq-wrap">
        <div class="section-head" data-reveal>
          <p class="eyebrow">{t.faq.eyebrow}</p>
          <h2>{t.faq.title}</h2>
        </div>
        <div class="faq">
          {
            t.faq.items.map((f) => (
              <details>
                <summary>
                  {f.q}
                  <Icon name="plus" size={20} />
                </summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CONTACT / QUOTE -->
    <section class="section contact-section" id="contact">
      <div class="container contact">
        <div class="contact-copy" data-reveal>
          <p class="eyebrow">{t.contact.eyebrow}</p>
          <h2>{t.contact.title}</h2>
          <p>{t.contact.lead}</p>
          <div class="contact-actions">
            {
              wa && (
                <a class="btn btn-ghost" href={wa} target="_blank" rel="noopener">
                  <Icon name="whatsapp" size={20} /> {t.contact.whatsapp}
                </a>
              )
            }
            {
              site.email && (
                <a class="btn btn-ghost" href={`mailto:${site.email}`} dir="ltr">
                  <Icon name="mail" size={20} /> {site.email}
                </a>
              )
            }
          </div>
        </div>
        <QuoteForm lang={lang} t={t.contact.form} />
      </div>
    </section>
  </main>

  <Footer lang={lang} t={t.footer} nav={t.nav} />

  {
    wa && (
      <a class="wa-fab" href={wa} target="_blank" rel="noopener" aria-label={t.contact.whatsapp}>
        <Icon name="whatsapp" size={28} />
      </a>
    )
  }
</Base>


<style>
  /* HERO */
  .hero {
    position: relative;
    padding-block: clamp(140px, 18vw, 200px) clamp(48px, 8vw, 96px);
    overflow: hidden;
  }
  .hero-orbit {
    position: absolute;
    inset-inline-end: -12vw;
    top: 4vw;
    width: min(70vw, 820px);
    aspect-ratio: 1;
    pointer-events: none;
  }
  .hero-orbit span {
    position: absolute;
    inset: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    transform: rotateX(68deg) rotateZ(-20deg);
  }
  .hero-orbit span:nth-child(2) {
    inset: 14%;
    border-color: rgba(31, 176, 216, 0.25);
    animation: spin 40s linear infinite;
  }
  .hero-orbit span:nth-child(3) {
    inset: 38%;
    border: 0;
    background: radial-gradient(circle, rgba(31, 176, 216, 0.35), transparent 65%);
    transform: none;
    filter: blur(20px);
  }
  @keyframes spin {
    to {
      transform: rotateX(68deg) rotateZ(340deg);
    }
  }
  .hero-inner {
    position: relative;
    display: grid;
    gap: 24px;
  }
  .hero h1 {
    font-size: clamp(2.8rem, 8vw, 6.4rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
  }
  .hero h1 span {
    display: block;
  }
  .accent {
    color: var(--accent);
  }
  .hero-lead {
    max-width: 620px;
    color: var(--text-muted);
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-block-start: 8px;
  }
  .reel {
    position: relative;
    display: block;
    margin-block-start: clamp(48px, 7vw, 88px);
    aspect-ratio: 16 / 7;
    max-width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    overflow: hidden;
    background: var(--bg-soft);
  }
  .reel video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .reel::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(7, 18, 22, 0.75), transparent 45%);
  }
  .reel-label {
    position: absolute;
    z-index: 1;
    bottom: 20px;
    inset-inline-start: 20px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-weight: 600;
  }
  .reel-play {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
  }

  .more-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-block-start: 24px;
    color: var(--accent);
    font-weight: 600;
  }
  [dir='rtl'] .more-link :global(svg) {
    transform: scaleX(-1);
  }

  /* PROCESS */
  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }
  .step {
    display: grid;
    align-content: start;
    gap: 10px;
    padding-block-start: 24px;
    border-top: 1px solid var(--line);
  }
  .step-num {
    color: var(--accent);
    font-weight: 700;
    font-size: 0.95rem;
  }
  .step h3 {
    font-size: 1.25rem;
  }
  .step p {
    color: var(--text-muted);
    font-size: 0.97rem;
  }

  /* STUDIO */
  .studio {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
    padding: clamp(32px, 6vw, 72px);
    border-radius: calc(var(--radius) * 1.5);
    background:
      radial-gradient(ellipse at 90% 10%, rgba(31, 176, 216, 0.16), transparent 50%),
      var(--bg-soft);
    border: 1px solid var(--line);
  }
  .studio-copy {
    display: grid;
    gap: 18px;
    justify-items: start;
  }
  .studio-copy h2 {
    font-size: clamp(1.8rem, 3.4vw, 2.7rem);
  }
  .studio-copy > p {
    color: var(--text-muted);
  }
  .studio-points {
    display: grid;
    gap: 8px;
    margin: 0 0 8px;
    padding: 0;
    list-style: none;
  }
  .studio-points li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .studio-points :global(svg) {
    color: var(--accent);
  }
  .studio-visual {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .studio-visual img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  /* PRINT */
  .print {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }
  .print-copy {
    display: grid;
    gap: 18px;
    justify-items: start;
  }
  .print-copy h2 {
    font-size: clamp(1.8rem, 3.4vw, 2.7rem);
  }
  .print-copy > p {
    color: var(--text-muted);
  }
  .print-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .print-list li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg-raised);
    font-weight: 600;
    font-size: 0.97rem;
  }
  .print-list :global(svg) {
    flex-shrink: 0;
    color: var(--accent);
  }

  /* BLOG */
  .blog-section {
    background: var(--bg-raised);
  }
  .blog-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
    margin-block-end: clamp(32px, 5vw, 56px);
  }
  .blog-head .section-head {
    margin: 0;
  }
  .blog-head .more-link {
    margin: 0;
  }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }

  /* WHY */
  .why-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .why-list li {
    display: grid;
    gap: 8px;
    align-content: start;
  }
  .why-list h3 {
    font-size: 1.15rem;
  }
  .why-list p {
    color: var(--text-muted);
    font-size: 0.97rem;
  }

  /* FAQ */
  .faq-wrap {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: clamp(24px, 6vw, 80px);
  }
  .faq details {
    border-bottom: 1px solid var(--line);
  }
  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 22px 0;
    font-weight: 600;
    font-size: 1.08rem;
    cursor: pointer;
    list-style: none;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary :global(svg) {
    flex-shrink: 0;
    color: var(--accent);
    transition: transform 0.3s;
  }
  .faq details[open] summary :global(svg) {
    transform: rotate(45deg);
  }
  .faq details p {
    padding-block-end: 22px;
    color: var(--text-muted);
  }

  /* CONTACT */
  .contact-section {
    background: var(--bg-raised);
  }
  .contact {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }
  .contact-copy {
    display: grid;
    gap: 18px;
    justify-items: start;
  }
  .contact-copy h2 {
    font-size: clamp(1.9rem, 3.6vw, 2.9rem);
  }
  .contact-copy > p {
    color: var(--text-muted);
  }
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* WHATSAPP FAB */
  .wa-fab {
    position: fixed;
    bottom: 20px;
    inset-inline-end: 20px;
    z-index: 40;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }

  @media (max-width: 960px) {
    .steps,
    .why-list {
      grid-template-columns: repeat(2, 1fr);
    }
    .studio,
    .print,
    .faq-wrap,
    .contact {
      grid-template-columns: 1fr;
    }
    .blog-grid {
      grid-template-columns: 1fr;
      max-width: 560px;
    }
    .studio-visual {
      order: -1;
    }
  }
  @media (max-width: 600px) {
    .steps,
    .why-list,
    .blog-grid,
    .print-list {
      grid-template-columns: 1fr;
    }
    .reel {
      aspect-ratio: 4 / 3;
    }
  }
</style>
