---
import { url } from '../utils/url';
import '@fontsource/ibm-plex-sans-arabic/400.css';
import '@fontsource/ibm-plex-sans-arabic/600.css';
import '@fontsource/ibm-plex-sans-arabic/700.css';
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  lang?: 'ar' | 'en';
  /** Path of this page in the other language, for hreflang + language switch. */
  altPath?: string;
  /** Extra JSON-LD objects for this page. */
  schema?: Record<string, unknown>[];
  /** 'article' for blog posts. */
  ogType?: 'website' | 'article';
  /** Path under /public for the share image (defaults to /og-image.jpg). */
  ogImage?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
}

const {
  title,
  description,
  lang = 'ar',
  altPath,
  schema = [],
  ogType = 'website',
  ogImage = '/og-image.jpg',
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;
const dir = lang === 'ar' ? 'rtl' : 'ltr';
const canonical = new URL(Astro.url.pathname, Astro.site);
const altLang = lang === 'ar' ? 'en' : 'ar';
const altUrl = altPath ? new URL(altPath, Astro.site) : undefined;

const sameAs = Object.values(site.social).filter(Boolean);
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name.en,
  alternateName: site.name.ar,
  url: Astro.site?.toString(),
  areaServed: { '@type': 'Country', name: 'Saudi Arabia' },
  ...(site.email && { email: site.email }),
  ...(site.phone && { telephone: site.phone }),
  ...(sameAs.length && { sameAs }),
};
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    {altUrl && <link rel="alternate" hreflang={altLang} href={altUrl} />}
    <link rel="alternate" hreflang="x-default" href={new URL(url('/'), Astro.site)} />
    <link rel="icon" href={url('/favicon-64.png')} type="image/png" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#071216" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_SA' : 'en_US'} />
    <meta property="og:image" content={new URL(url(ogImage), Astro.site)} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'ar' ? 'تخطَّ إلى المحتوى' : 'Skip to content'}</a>
    <slot />
    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    inset-inline-start: 16px;
    top: -100px;
    z-index: 100;
    padding: 10px 16px;
    border-radius: 8px;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 600;
  }
  .skip-link:focus {
    top: 16px;
  }
</style>
