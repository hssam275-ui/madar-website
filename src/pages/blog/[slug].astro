---
import { getCollection, render } from 'astro:content';
import PageShell from '../../components/PageShell.astro';
import BlogCard from '../../components/BlogCard.astro';
import Icon from '../../components/Icon.astro';
import { url } from '../../utils/url';
import { site } from '../../data/site';
import { extractFaq } from '../../utils/faq';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, seoTitle, description, date, updated, cover } = post.data;
const fmt = new Intl.DateTimeFormat('ar-SA-u-ca-gregory-nu-latn', { day: 'numeric', month: 'long', year: 'numeric' });
const others = (await getCollection('blog', (p) => !p.data.draft && p.id !== post.id))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
const pageUrl = new URL(url(`/blog/${post.id}/`), Astro.site).href;
const blogUrl = new URL(url('/blog/'), Astro.site).href;
const imageUrl = cover ? new URL(url(cover), Astro.site).href : undefined;
const faq = extractFaq(post.body);
const schema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: date.toISOString(),
    dateModified: (updated ?? date).toISOString(),
    inLanguage: 'ar',
    mainEntityOfPage: pageUrl,
    url: pageUrl,
    ...(imageUrl && { image: imageUrl }),
    author: { '@type': 'Organization', name: site.name.ar, url: Astro.site?.toString() },
    publisher: { '@type': 'Organization', name: site.name.ar, url: Astro.site?.toString() },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: site.shortName.ar, item: new URL(url('/'), Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'المقالات', item: blogUrl },
      { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
    ],
  },
];
if (faq.length) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---

<PageShell
  lang="ar"
  title={`${seoTitle ?? title} | ${site.shortName.ar}`}
  description={description}
  altPath={url('/en/')}
  schema={schema}
  ogType="article"
  ogImage={cover}
  publishedTime={date}
  modifiedTime={updated}
>
  <article class="article">
    <header class="container narrow head">
      <nav class="crumbs" aria-label="مسار التنقل">
        <a href={url('/')}>{site.shortName.ar}</a>
        <span aria-hidden="true">/</span>
        <a href={url('/blog/')}>المقالات</a>
      </nav>
      <h1>{title}</h1>
      <p class="desc">{description}</p>
      <time datetime={date.toISOString()}>{fmt.format(date)}</time>
    </header>
    {
      cover && (
        <div class="container cover">
          <img src={url(cover)} alt="" width="1600" height="900" />
        </div>
      )
    }
    <div class="container narrow prose">
      <Content />
    </div>
    <div class="container narrow cta">
      <div>
        <h2>عندك مشروع؟</h2>
        <p>أخبرنا بفكرتك، ونعود إليك بخطة وعرض سعر.</p>
      </div>
      <a class="btn btn-primary" href={url('/#contact')}>اطلب عرض سعر <Icon name="arrow" size={18} /></a>
    </div>
  </article>

  {
    others.length > 0 && (
      <section class="more">
        <div class="container">
          <h2>مقالات أخرى</h2>
          <div class="grid">
            {others.map((p) => <BlogCard post={p} readLabel="اقرأ المقال" />)}
          </div>
        </div>
      </section>
    )
  }
</PageShell>

<style>
  .narrow {
    max-width: 780px;
  }
  .head {
    display: grid;
    gap: 16px;
    padding-block: clamp(130px, 16vw, 170px) 32px;
  }
  .crumbs {
    display: flex;
    gap: 8px;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .crumbs a:hover {
    color: var(--accent);
  }
  h1 {
    font-size: clamp(1.9rem, 4.4vw, 3rem);
    line-height: 1.3;
  }
  .desc {
    color: var(--text-muted);
    font-size: 1.12rem;
  }
  time {
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 600;
  }
  .cover {
    max-width: 1000px;
    margin-block-end: 40px;
  }
  .cover img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .prose {
    font-size: 1.1rem;
    line-height: 2;
  }
  .prose :global(h2) {
    margin-block: 2.2em 0.6em;
    font-size: 1.5rem;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin-block: 0 1.1em;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-inline-start: 1.4em;
  }
  .prose :global(li) {
    margin-block-end: 0.35em;
  }
  .prose :global(li::marker) {
    color: var(--accent);
  }
  .prose :global(strong) {
    color: var(--text);
  }
  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .prose :global(table) {
    display: block;
    overflow-x: auto;
    width: 100%;
    margin-block: 0 1.4em;
    border-collapse: collapse;
    font-size: 0.95rem;
    line-height: 1.7;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 10px 14px;
    border: 1px solid var(--line);
    text-align: start;
    vertical-align: top;
  }
  .prose :global(th) {
    background: var(--bg-raised);
    color: var(--text);
    white-space: nowrap;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-block: 48px var(--section);
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raised);
  }
  .cta h2 {
    font-size: 1.4rem;
  }
  .cta p {
    color: var(--text-muted);
  }
  .more {
    padding-block: var(--section);
    background: var(--bg-raised);
  }
  .more h2 {
    margin-block-end: 28px;
    font-size: 1.6rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
    max-width: 860px;
  }
  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
